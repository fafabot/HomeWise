module posicionar_no_painel(ox, oz, e_off=0) {
  // Painel em Y=142..145, face frontal em Y=142 apontando para -Y!
  translate([ox, 142 - e_off, 3 + oz]) rotate([90, 0, 0]) children();
}

module montagem(explodido=false) {
  e = explodido ? 50 : 0;
  color("#c89d6c") translate([0, 145 + e, 3 + e]) rotate([90, 0, 0]) peca("01_painel_totem_460x340");
  color("#b68b5b") translate([0, 0, 0]) peca("02_base_totem_460x200");
  color("#a37b4c") translate([15 - e, 142, 3]) rotate([90, 0, -90]) peca("03_escora_vazada_esquerda");
  color("#a37b4c") translate([448 + e, 142, 3]) rotate([90, 0, -90]) peca("04_escora_vazada_direita");

  color("#16a3b8") posicionar_no_painel(60, 254, e*0.6) peca("05_suporte_3d_clipe_funil");
  color("#16a3b8") posicionar_no_painel(57, 130, e*0.6) peca("06_suporte_3d_berco_yfs201");
  color("#1e3a8a") posicionar_no_painel(193, 155, e*0.6) peca("07_suporte_3d_base_wemos_d1");
  color("#ea580c") posicionar_no_painel(305, 152, e*0.6) peca("08_suporte_3d_case_pzem004t");

  for (pt = [[125, 143.5], [230, 143.5], [335, 143.5], [13.5, 70], [446.5, 70]])
    color("#374151") translate([pt[0], pt[1], 0]) rotate([180, 0, 0]) peca("09_pe_nivelador_m3");
}

if (peca_exportar != "") {
  peca(peca_exportar);
} else if (peca_id == 1) {
  peca("05_suporte_3d_clipe_funil");
} else if (peca_id == 2) {
  peca("06_suporte_3d_berco_yfs201");
