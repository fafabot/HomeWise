# Copie este arquivo para .env na pasta api e preencha os valores locais.
# Nunca envie a senha real do MySQL para o GitHub.

PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=homewise_app
DB_PASSWORD=COLOQUE_SUA_SENHA_AQUI
DB_NAME=homewise
DEVICE_ID=central_homewise_01

# Para desenvolvimento local. Em producao, substitua pela origem do site publicado.
CORS_ORIGIN=*
